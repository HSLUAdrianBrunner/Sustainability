    "from sklearn.preprocessing import StandardScaler\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import import_ipynb\n",
    "\n",
    "path = \"Data/\"\n",
    "exog_features= pd.read_csv(path+ 'exog_features.csv')\n",
    "exog_features = exog_features.select_dtypes(include=['number'])\n",
    "\n",
    "scaler = StandardScaler()\n",
    "exog_scaled = pd.DataFrame(scaler.fit_transform(exog_features),\n",
    "                           columns=exog_features.columns,\n",
    "                           index=exog_features.index)\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "sns.heatmap(exog_scaled.corr(), annot=True, fmt=\".2f\")\n",
    "plt.show()\n"
   ],
